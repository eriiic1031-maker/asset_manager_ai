{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "자산관리 AI 실행 (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "자산관리 AI 실행 (휴대폰 QR 스캔 허용)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.address", "0.0.0.0"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
